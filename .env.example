# ---- Server ----
PORT=8080
NODE_ENV=development
# Required by `pnpm dev:tunnel` / `pnpm start:tunnel`.
NGROK_AUTHTOKEN=
# Optional reserved ngrok domain.
# NGROK_DOMAIN=

# ---- Supabase ----
# Postgres connection string (Settings > Database > Connection string)
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Perpl (testnet defaults; swap for mainnet values) ----
PERPL_API_URL=https://testnet.perpl.xyz/api
PERPL_WS_URL=wss://testnet.perpl.xyz
PERPL_CHAIN_ID=10143

# Builder code: registered by Perpl. 0 = no builder fee charged.
PERPL_BUILDER_ID=0
# Fee charged per order, in per_100k (1 = 0.1 bps). Capped at 100 (0.1%) and
# at each user's signed enrollment ceiling.
PERPL_BUILDER_FEE_PER_100K=10

# AES-256-GCM key for encrypting stored Perpl API key material (64 hex chars = 32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_KEY=

# Origin sent with the API-key enrollment payload (must be whitelisted by Perpl).
APP_ORIGIN=http://localhost:8080

# Copy engine tuning
COPY_DELAY_MS=1500
# DRY_RUN=true logs the orders the copy engine would place instead of
# submitting them (rows flagged dry_run). Kill-switch closes are simulated too.
DRY_RUN=true
COPY_POLL_MS=2000
LEADER_SNAPSHOT_MS=60000
TOURNAMENT_SNAPSHOT_MS=60000
RISK_CHECK_MS=15000
